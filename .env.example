# ─── DATABASE ─────────────────────────────────────────────
DATABASE_URL="postgresql://spg:spg_dev_password@localhost:5432/spg_juridico"

# ─── REDIS ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── AUTH ──────────────────────────────────────────────────
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_VERY_LONG_SECRET"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── API ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
API_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# ─── ENCRYPTION (for credentials stored in DB) ────────────
ENCRYPTION_KEY="CHANGE_ME_32_CHARS_FOR_AES256_KEY"

# ─── TWILIO / WHATSAPP ─────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── EMAIL (Nodemailer) ────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SPG Juridico <no-reply@spgjuridico.com.ar>"

# ─── FILE STORAGE ──────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# ─── NEXT.JS PUBLIC ────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
